# Leave empty in dev: requests go same-origin through the Vite proxy. Prod: https://api.hideout.gg
VITE_API_URL=
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_LIVEKIT_URL=ws://localhost:7880

# Dev server only (read by vite.config.ts, not exposed to the browser)
DEV_PORT=5173
DEV_API_PROXY_TARGET=http://localhost:3001
