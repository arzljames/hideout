{
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run gen:api:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch -c:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npx shadcn@latest add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Edit(src/lib/api/schema.d.ts)",
      "Edit(src/routeTree.gen.ts)",
      "Write(src/routeTree.gen.ts)",
      "Write(src/lib/api/schema.d.ts)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)"
    ]
  }
}